{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/life2boat/hermes/schemas/production-readiness-evidence-v1.schema.json",
  "title": "ProductionReadinessEvidenceReceipt v1",
  "description": "Content-bound, tamper-evident receipt proving production readiness evidence quality. EVIDENCE_EXPANDS_AUTHORITY=false.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "repository",
    "canonical_remote",
    "candidate_sha",
    "observed_head_sha",
    "runtime_evidence_source_sha",
    "target",
    "attestation_id",
    "comparison_id",
    "intended_digest",
    "collected_at_utc",
    "evaluated_at_utc",
    "max_age_seconds",
    "comparison_status",
    "post_collection_health_status",
    "evidence_refs",
    "final_status",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of canonical JSON of all other fields."
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+ -]{0,255}$"
    },
    "canonical_remote": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+ -]{0,255}$"
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Release candidate Git SHA being evaluated. Does NOT claim to equal production_sha."
    },
    "observed_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "runtime_evidence_source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Git SHA of the repository source used to run/verify the runtime evidence collectors. NOT the production_sha."
    },
    "target": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+ -]{0,255}$"
    },
    "attestation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "comparison_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intended_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "collected_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "evaluated_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "max_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum evidence age in seconds. Stale evidence yields BLOCKED."
    },
    "comparison_status": {
      "enum": ["MATCH", "DRIFT", "INSUFFICIENT_EVIDENCE"]
    },
    "post_collection_health_status": {
      "enum": ["PASS", "FAIL", "INSUFFICIENT_EVIDENCE"]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(artifact:production-runtime-(attestation|comparison):[0-9a-f]{64}|source:[0-9a-f]{40})$"
      },
      "description": "Sanitized evidence references only. No raw secrets or production data."
    },
    "final_status": {
      "enum": ["PASS", "FAIL", "BLOCKED"],
      "description": "PASS does not authorize production execution. EVIDENCE_EXPANDS_AUTHORITY=false."
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
      }
    }
  }
}
